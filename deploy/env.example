# Slurp garmin-mcp: environment file for the service.
# Installed as /etc/slurp-garmin-mcp/env (system unit) or
# ~/.config/slurp-garmin-mcp/env (user unit). Keep it mode 0640 or stricter.
# Lines are KEY=value, no quotes, no `export`.

# --- Transport ---------------------------------------------------------------
# stdio (default, for local clients) | streamable-http | sse
GARMIN_MCP_TRANSPORT=streamable-http
# Bind address and port. Keep 127.0.0.1 behind a reverse proxy or tunnel.
GARMIN_MCP_HOST=127.0.0.1
GARMIN_MCP_PORT=8000
# No sessions: recommended for long-lived remote deployments (claude.ai
# connectors report an expired session as a failed tool call).
GARMIN_MCP_STATELESS_HTTP=true
# Per-request timeout in seconds for calls to Garmin (default 90, 0 = off).
#GARMIN_MCP_CALL_TIMEOUT=90

# --- HTTP authentication (set at least one) ----------------------------------
# Refuse to start an HTTP transport without a token or URL secret.
GARMIN_MCP_REQUIRE_AUTH=true
# Bearer token: clients send "Authorization: Bearer <token>".
#GARMIN_MCP_HTTP_TOKEN=
#GARMIN_MCP_HTTP_TOKEN_FILE=/etc/slurp-garmin-mcp/http-token
# URL secret: MCP is served at /<secret>/mcp only; for clients that cannot send
# a header (claude.ai custom connectors). At least 16 characters of
# letters, digits and -._~ ; generate with: openssl rand -hex 32
#GARMIN_MCP_URL_SECRET=
GARMIN_MCP_URL_SECRET_FILE=/etc/slurp-garmin-mcp/url-secret

# --- Host and Origin checks -------------------------------------------------
# Behind a proxy or tunnel that forwards the public host name (Tailscale
# Funnel, Caddy, nginx) the server answers 421 Invalid Host header unless that
# name is listed here. Comma-separated, no scheme or path.
#GARMIN_MCP_ALLOWED_HOSTS=myhost.tailnet.ts.net
# Browser-style clients that send an Origin header; comma-separated.
#GARMIN_MCP_ALLOWED_ORIGINS=https://claude.ai

# --- Garmin account ----------------------------------------------------------
# Token directory, created once with `garmin-mcp-auth`. The system unit sets
# this to its state directory (/var/lib/slurp-garmin-mcp); override here only
# if the tokens live elsewhere.
#GARMINTOKENS=/var/lib/slurp-garmin-mcp
# Tokens as one base64 string instead of a directory.
#GARMINTOKENS_BASE64=
# Password login is only a fallback for accounts without MFA; prefer tokens.
#GARMIN_EMAIL=
#GARMIN_EMAIL_FILE=
#GARMIN_PASSWORD=
#GARMIN_PASSWORD_FILE=
# true for Garmin Connect China (garmin.cn).
#GARMIN_IS_CN=false

# --- Tools -------------------------------------------------------------------
# Built-in subset(s), comma-separated; see docs/configuration.md.
#GARMIN_TOOL_PROFILE=
# Allowlist / denylist of tool names, comma-separated.
#GARMIN_ENABLED_TOOLS=
#GARMIN_DISABLED_TOOLS=

# --- Activity file downloads -------------------------------------------------
# Must be a directory the service may write to (the state directory).
#GARMIN_FIT_DOWNLOAD_DIR=/var/lib/slurp-garmin-mcp/downloads
#GARMIN_FIT_CONFIG=/var/lib/slurp-garmin-mcp/fit_config.json
